# --- Mode -----------------------------------------------------------------
# demo  = run fully offline on synthetic data (no Global Datafeeds keys needed)
# live  = call Global Datafeeds APIs with the keys below
GTP_MODE=demo

# --- Global Datafeeds: Price data (REST) ---------------------------------
# Host and port come from your GDF onboarding email: http://endpoint:port
GDF_PRICE_BASE_URL=http://endpoint:port
GDF_PRICE_ACCESS_KEY=

# --- Global Datafeeds: Fundamental / corporate data ----------------------
GDF_FUNDAMENTAL_BASE_URL=https://test.lisuns.com:4532
GDF_FUNDAMENTAL_ACCESS_KEY=

# --- Global Datafeeds: Mutual funds ---------------------------------------
GDF_MF_BASE_URL=
GDF_MF_ACCESS_KEY=

# --- Global Datafeeds: News ------------------------------------------------
GDF_NEWS_BASE_URL=
GDF_NEWS_API_KEY=
# Shared secret GDF must send (?token=...) when POSTing to /webhooks/gdf/news
GTP_WEBHOOK_SECRET=change-me

# --- Platform ---------------------------------------------------------------
GTP_DB_PATH=gtp.db
GTP_ADMIN_TOKEN=change-me-admin
# Optional CSV (column "Identifier") with the screener universe,
# e.g. the Nifty 100 constituents file GDF delivers monthly.
GTP_UNIVERSE_CSV=
